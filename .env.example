# Grove Dashboard Environment Configuration
# Copy this file to .env and update with your values

# Server Configuration
NODE_ENV=development
PORT=3211

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/grove_db

# Email Configuration (SMTP)
# Hostname of your SMTP server (e.g. smtp.gmail.com, smtp.zoho.com, mail.yourdomain.com)
SMTP_HOST=smtp.yourprovider.com
# Port: 587 (STARTTLS) or 465 (implicit TLS)
SMTP_PORT=587
# Set to true when using port 465 with implicit TLS, otherwise false (STARTTLS)
SMTP_SECURE=false
# Username/password for SMTP authentication (leave blank if the server allows unauthenticated sends)
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# Sender address used in the From header
EMAIL_FROM="Grove Alert System <your-email@gmail.com>"

VITE_PUBLIC_API_KEY=sk_8im9efe8sz6g2otsxlhvhf
